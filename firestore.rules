rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ratingFields() { return ['ratingSum', 'ratingCount', 'score', 'love', 'fine', 'meh']; }

    // schools by student email domain (same list as lib/school.js)
    function schoolEmail() {
      return {
        'purdue': '.*@([a-z0-9-]+[.])*purdue[.]edu',
        'ucla': '.*@([a-z0-9-]+[.])*ucla[.]edu',
        'usc': '.*@([a-z0-9-]+[.])*usc[.]edu',
        'berkeley': '.*@([a-z0-9-]+[.])*berkeley[.]edu',
        'stanford': '.*@([a-z0-9-]+[.])*stanford[.]edu',
        'uci': '.*@([a-z0-9-]+[.])*uci[.]edu',
        'ucr': '.*@([a-z0-9-]+[.])*ucr[.]edu',
        'mit': '.*@([a-z0-9-]+[.])*mit[.]edu',
        'nyu': '.*@([a-z0-9-]+[.])*nyu[.]edu',
        'cmu': '.*@([a-z0-9-]+[.])*cmu[.]edu',
        'uw': '.*@([a-z0-9-]+[.])*uw[.]edu',
        'uiuc': '.*@([a-z0-9-]+[.])*illinois[.]edu',
        'erau': '.*@([a-z0-9-]+[.])*erau[.]edu'
      };
    }
    // you're at a school when the student email in your private note is at that school's domain,
    // and opening its emailed link recorded it as yours (schoolEmails/{email}.owner)
    function verifiedAt(campusId) {
      return campusId in schoolEmail()
        && provenAt(get(/databases/$(database)/documents/users/$(request.auth.uid)/private/school).data.email, campusId);
    }
    function provenAt(email, campusId) {
      return email.matches(schoolEmail()[campusId])
        && get(/databases/$(database)/documents/schoolEmails/$(email)).data.owner == request.auth.uid;
    }
    function sameSchool() {
      return request.resource.data.get('campusId', null) == resource.data.get('campusId', null);
    }

    match /users/{uid} {
      allow read: if signedIn();
      // picking or changing your school needs a confirmed student email there (your login can be any email)
      allow create: if signedIn() && request.auth.uid == uid
        && (!('campusId' in request.resource.data) || verifiedAt(request.resource.data.campusId));
      allow update: if signedIn() && request.auth.uid == uid
        && (sameSchool() || verifiedAt(request.resource.data.campusId));
      allow delete: if signedIn() && request.auth.uid == uid;

      // which student email you're confirming; only you can see it
      match /private/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // friends can see each other's lists (taste match, "their list")
      match /rankings/{dishId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // anyone signed in can add a dish; after that only the rating fields move
    match /dishes/{dishId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.addedBy == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ratingFields());
    }

    // per-place totals behind "everyone's rating"; created by the first review at that place
    match /places/{placeId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(ratingFields().concat(['campusId', 'name']));
    }

    // student-posted deals; anyone can vote "still good", only the poster can take it down
    match /deals/{dealId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.postedBy == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
      allow delete: if signedIn() && resource.data.postedBy == request.auth.uid;
    }

    // review photos (small jpegs as data links). only you can add yours, and each stays under ~600 KB
    match /photos/{photoId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 600000
        && request.resource.data.data.matches('data:image/.*');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // written by opening the link in a student email: only someone who just proved that inbox can say
    // which account it belongs to. the account it names can read it back to finish switching schools
    match /schoolEmails/{email} {
      allow create, update: if request.auth != null
        && request.auth.token.email == email
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['owner', 'campusId', 'at'])
        && request.resource.data.owner is string;
      allow read: if request.auth != null
        && (resource.data.owner == request.auth.uid || request.auth.token.email == email);
      // deleting your account removes it
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      // anyone can like; the author can also fix the words (not the score)
      allow update: if signedIn()
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
          || (resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'tags', 'editedAt'])));
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
