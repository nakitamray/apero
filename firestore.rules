rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      match /rankings/{dishId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // anyone signed in can add a dish; after that only the rating fields move
    match /dishes/{dishId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.addedBy == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount', 'score']);
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
