rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ratingFields() { return ['ratingSum', 'ratingCount', 'score', 'love', 'fine', 'meh']; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      // friends can see each other's lists (taste match, "their list")
      match /rankings/{dishId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // anyone signed in can add a dish; after that only the rating fields move
    match /dishes/{dishId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.addedBy == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ratingFields());
    }

    // per-place totals behind "everyone's rating"; created by the first review at that place
    match /places/{placeId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(ratingFields().concat(['campusId', 'name']));
    }

    // student-posted deals; anyone can vote "still good", only the poster can take it down
    match /deals/{dealId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.postedBy == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
      allow delete: if signedIn() && resource.data.postedBy == request.auth.uid;
    }

    // review photos (small jpegs as data links). only you can add yours, and each stays under ~600 KB
    match /photos/{photoId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 600000
        && request.resource.data.data.matches('data:image/.*');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
