{
  "expo": {
    "name": "apero",
    "slug": "apero",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2456B8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nakitamray.apero"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2456B8"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nakitamray.apero"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "apero shows where you are on the map of places to eat around campus."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "apero lets you add photos of your food to your reviews."
        }
      ]
    ]
  }
}
